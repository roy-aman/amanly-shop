# Local dev: Vite proxies /api/* to the backend (see vite.config.ts server.proxy).
# VITE_API_BASE_URL intentionally unset — same-origin proxying, no CORS needed.
API_PROXY_TARGET=http://localhost:8088
#
# To point the dev proxy at a different backend, set API_PROXY_TARGET:
#   PowerShell: $env:API_PROXY_TARGET='http://192.168.1.5:8080'; npm run dev:local
#   macOS/Linux: API_PROXY_TARGET=http://192.168.1.5:8080 npm run dev:local
